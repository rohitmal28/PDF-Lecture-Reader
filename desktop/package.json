{
  "name": "pdf-lecture-reader",
  "productName": "StudyDesk PDF",
  "version": "2.0.0",
  "description": "StudyDesk PDF: Lecture Reader reads PDFs aloud like a teacher; PDF Tools merge, convert and edit PDFs.",
  "author": "Rohit Mal",
  "license": "SEE LICENSE IN LICENSE.txt",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:store": "electron-builder --win appx --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.rohitmal.pdflecturereader",
    "productName": "StudyDesk PDF",
    "copyright": "© 2026 Rohit Mal",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["app/**/*", "package.json"],
    "extraResources": [
      { "from": "resources/LICENSE.txt", "to": "LICENSE.txt" },
      { "from": "resources/THIRD-PARTY-NOTICES.txt", "to": "THIRD-PARTY-NOTICES.txt" }
    ],
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "artifactName": "StudyDesk-PDF-${version}-mac.${ext}",
      "fileAssociations": [
        { "ext": "pdf", "name": "PDF document", "role": "Viewer", "rank": "Alternate", "isPackage": false }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "StudyDesk-PDF-Setup-${version}.${ext}"
    },
    "appx": {
      "applicationId": "StudyDeskPDF",
      "identityName": "REPLACE.WithPackageIdentityName",
      "publisher": "CN=REPLACE-WITH-PUBLISHER-ID",
      "publisherDisplayName": "Rohit Mal",
      "displayName": "StudyDesk PDF",
      "backgroundColor": "transparent",
      "languages": ["en-IN", "en-US", "en-GB"],
      "artifactName": "StudyDesk-PDF-${version}-store.${ext}"
    },
    "nsis": {
      "guid": "PDFLectureReader",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "resources/LICENSE.txt",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "StudyDesk PDF",
      "uninstallDisplayName": "StudyDesk PDF",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "StudyDesk PDF ${version}",
      "contents": [
        { "x": 150, "y": 190, "type": "file" },
        { "x": 390, "y": 190, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 540, "height": 380 }
    }
  }
}
